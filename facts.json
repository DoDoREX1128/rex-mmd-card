  "note": "平台数值与已记录能力的数据源；作者偏好单独标注。先核对版本、域名、部署日期和证据范围，再比较源码、实测与公开资料。冲突见 references/56-能力边界与证据.md。",
  "markers": {
    "ignition": {
      "open": "【",
      "close": "】",
      "prefix": "rex-",
      "note": "注入标记，出现在 beginning / statusbar / findRegex。用中文方括号而非尖括号：避开创卡页对 findRegex 的 HTML 标签文案禁令，也不受正则转义影响。",
      "evidence": "official"
    },
    "content": {
      "open": "[",
      "close": "]",
      "block": "[status]",
      "closeBlock": "[/status]",
      "mustConsume": true,
      "note": "内容协议使用方括号。渲染边界：① 模型输出的中文尖括号标签会在进正则前被剥壳正则整段删掉；② 连字符尖括号虽能存活，但会以未知元素留在气泡里，玩家直接看到 JSON；③ 方括号不参与 HTML 解析，不存在被净化或提前闭合的问题。代价是必须由一条规则显式消耗：findRegex 写 /\\[status\\][\\s\\S]*?\\[\\/status\\]/，replaceString 渲染成紧凑卡或空串。不消耗就原样显示。",
      "evidence": "device"
    }
  },
  "sentenceBans": {
    "items": [
      {
        "id": "neg-first",
        "label": "先否定再肯定",
        "rule": "禁止「不是…是…」「不是…而是…」「与其说…不如说…」这类句式",
        "fix": "删掉否定那半句；删完不通就把后半句补成完整陈述，仍不写成对偶"
      },
      {
        "id": "flat-metaphor",
        "label": "生硬比喻",
        "rule": "禁止「A等于B」「A就是B」式判断句冒充比喻",
        "fix": "写 B 的具体特征，让读者自己得出 A 像 B；不要用系词直接等号"
      },
      {
        "id": "jargon",
        "label": "术语腔与抽象词堆叠",
        "rule": "禁止外显、建制、成正比、位移、闭环、赋能、维度、底层逻辑这八个词，以及同类名词化抽象",
        "fix": "换成可观察的动作、位置、数量、时间；写不出具体画面就删掉整句"
      },
      {
        "id": "repeat",
        "label": "同段重复",
        "rule": "禁止同一句信息在两处原样重复；同一段里意思重复的句子只留一句",
        "fix": "保留信息更具体的那句；另一句改成推进（代价、后果、例外），改不了就删"
      }
    ],
    "scope": "--style-lint 显式开启后，仅给可选笔记体建议；不要求写入人设，不限制用户自定义格式或文风。",
    "enforcement": "仅显式--style-lint时对人设与世界书给WARN；是否采用按用户文风决定，不作默认交付门禁。",
    "evidence": "author"
  },
  "aiTone": {
    "baseline": "仅--style-lint显式开启时提示笔记体风格，不用于判断作者身份或内容质量。",
    "signals": [
      {
        "id": "long-line",
        "label": "平均每行过长",
        "rule": "平均每行 >40 字",
        "fix": "一行一件事，写完就停"
      },
      {
        "id": "long-sentence",
        "label": "长句过多",
        "rule": "长句（>40 字）占比 >8%",
        "fix": "拆成两句，或改用分号"
      },
      {
        "id": "period-heavy",
        "label": "句号偏多",
        "rule": "句号密度 >18‰",
        "fix": "字段行不必加句号；笔记体不是文章"
      },
      {
        "id": "parallel",
        "label": "排比三连",
        "rule": "「；…；…」三段并列 ≥3 处",
        "fix": "保留两项，或拆成两句"
      },
      {
        "id": "antithesis",
        "label": "对偶金句",
        "rule": "「X很A，Y很B」≥1 处",
        "fix": "拆开写，信息不变"
      },
      {
        "id": "causal",
        "label": "因果解释",
        "rule": "因为 / 所以 / 因此 / 从而 / 于是 ≥1 处",
        "fix": "删连接词，两句并列"
      },
      {
        "id": "dash",
        "label": "破折号过多",
        "rule": "—— ≥4 处",
        "fix": "改用括号，或另起一句"
      },
      {
        "id": "fill",
        "label": "每字段写满",
        "rule": "一个字段 3 段以上且有起承转合",
        "fix": "删一半，看角色会不会变"
      }
    ],
    "note": "这些指标是可选写作偏好，不作平台限制或通用质量标准。",
    "evidence": "author"
  },

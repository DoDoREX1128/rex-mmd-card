{
  "beginning": "晨钟初歇。外门执事把差事木牌推到 {{user}} 面前，等候回应。",
  "statusbar": "",
  "regex_scripts": [
    {
      "scriptName": "native-status",
      "findRegex": "/\\[status\\]hp::(\\d{1,3});;loc::([^<>\\[\\]\\n]{0,40})\\[\\/status\\]/g",

      { "key": "power", "label": "战力", "type": "choice", "options": ["（弱）", "（中）", "（强）"] },
      { "key": "origin", "label": "初始所在地", "type": "choice", "source": "map.nodes" },
      { "key": "background", "label": "背景补充", "type": "text", "multiline": true, "optional": true }

    "version": "1.0",
    "adult": true,
    "defaultName": "无名客",
    "opening": "（开场第一段：一个正在发生的动作或环境细节，不写世界史。）\n\n（第二段：主角在场但还没被点名，第二人称。）\n\n（第三段：留一个钩子 —— 一句没说完的话、一个正在靠近的人、一件缺的东西。）"
  },
  "theme": {
    "bg": "#0d0b0a",
    "surface": "#171310",
    "surface2": "#1e1a16",
    "line": "#2b2520",
    "text": "#f2ece0",
    "dim": "#9a8f80",
    "accent": "#c9a227",
    "accent2": "#7a1f1f"
  },
  "world": {
    "era": "（时代与地点，一句）",

# 统一换行，避免中文文档在 Windows / macOS 之间产生整文件 diff
* text=auto eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 生成的索引与事实表：语言统计里排除，别让它们污染仓库指标
references/23-平台-事实表.md linguist-generated=true
references/fields/index.md linguist-generated=true
references/errors/index.md linguist-generated=true
facts.json linguist-detectable=true
